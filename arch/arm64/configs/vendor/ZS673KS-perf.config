###############################################################################################
#
# Reverse the order of the configs for the override to work properly
# Correct order is : 
#1.base_defconfig : kernel/msm-5.4/arch/arm64/configs/gki_defconfig 
#2.GKI.config : /kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_GKI.config (GKI.config)
#3.QGKI.config : /kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_QGKI.config  (QGKI.config)
#4.Consolidate.config : /kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_consolidate.config
#5.debug.config : kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_debug.config  (debug.config)
#6.asus_defconfig : kernel/msm-5.4/arch/arm64/configs/vendor/ZS673KS_defconfig
#
###############################################################################################
CONFIG_LOCALVERSION="-qgki-perf"
CONFIG_MACH_ASUS_ZS673KS=y
CONFIG_TOUCHSCREEN_ROG=y
CONFIG_TOUCHSCREEN2_ROG=m
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_NET_SCH_NETEM=y
CONFIG_SLA_STAIC_COLLECT=y
CONFIG_SLA=m
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_INPUT_SX932X=m
CONFIG_INPUT_SX932X_2ND=m

# vibrator
CONFIG_AW8697_HAPTIC=y

CONFIG_INPUT_HALLSENSOR=m
CONFIG_INPUT_HALLSENSOR2=m
# ASUS_BSP : Support PD_RT1715 +++
CONFIG_RT_REGMAP=y
CONFIG_TCPC_CLASS=y
CONFIG_USB_POWER_DELIVERY=y
CONFIG_TCPC_RT1711H=y
CONFIG_USB_CONFIGFS_F_MTP=y
CONFIG_USB_CONFIGFS_F_PTP=y
# ASUS_BSP : Support PD_RT1715 ---
# ASUS BSP Fingerprint +++
CONFIG_GOODIX_FINGERPRINT=m
# CONFIG_MSM_QBT_HANDLER is not set
# ASUS BSP Fingerprint ---

##########################################
# user version config...
##########################################

CONFIG_CORESIGHT=y
CONFIG_CORESIGHT_LINKS_AND_SINKS=y
CONFIG_CORESIGHT_LINK_AND_SINK_TMC=y
CONFIG_CORESIGHT_SOURCE_ETM4X=y
CONFIG_CORESIGHT_DYNAMIC_REPLICATOR=y
CONFIG_CORESIGHT_STM=y
CONFIG_CORESIGHT_CTI=y
CONFIG_CORESIGHT_OST=y
CONFIG_CORESIGHT_TPDA=y
CONFIG_CORESIGHT_TPDM=y
CONFIG_CORESIGHT_HWEVENT=y
CONFIG_CORESIGHT_DUMMY=y
CONFIG_CORESIGHT_REMOTE_ETM=y
CONFIG_CORESIGHT_REMOTE_ETM_DEFAULT_ENABLE=0
CONFIG_CORESIGHT_CSR=y
CONFIG_CORESIGHT_TGU=y
CONFIG_CORESIGHT_EVENT=y
CONFIG_CORESIGHT_QGKI=y
CONFIG_CORESIGHT_CTI_SAVE_DISABLE=y
CONFIG_QCOM_QDSS_BRIDGE=y

CONFIG_USB_F_QDSS = y
CONFIG_USB_CONFIGFS_F_QDSS=y
CONFIG_DEBUG_ALIGN_RODATA=y
CONFIG_MSM_REMOTEQDSS=y

CONFIG_CMA_DEBUG=n
CONFIG_CMA_DEBUGFS=n
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n
CONFIG_MHI_DEBUG=n
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=n
CONFIG_SPMI_QTI_GLINK_DEBUG=y
CONFIG_REGULATOR_QTI_DEBUG=n
CONFIG_MSM_GPI_DMA_DEBUG=n
#CONFIG_COMMON_CLK_QCOM_DEBUG=n
CONFIG_MSM_DEBUGCC_LAHAINA=n
CONFIG_SM_DEBUGCC_SHIMA=n
CONFIG_IOMMU_TLBSYNC_DEBUG=n
CONFIG_IOMMU_DEBUG=n
CONFIG_QMP_DEBUGFS_CLIENT=n
CONFIG_QTI_PMIC_GLINK_CLIENT_DEBUG=n
CONFIG_QTI_BATTERY_GLINK_DEBUG=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_SERIAL_MSM_GENI_CONSOLE=n
CONFIG_DEBUG_CONSOLE_UNHASHED_POINTERS=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_PAGEALLOC=n
CONFIG_DEBUG_PANIC_ON_OOM=n
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=n
# CONFIG_DEBUG_PREEMPT is not set
CONFIG_DEBUG_SPINLOCK=n



CONFIG_SLUB_DEBUG=y

CONFIG_TRACEPOINTS=n

CONFIG_SERIAL_EARLYCON=n

CONFIG_SERIAL_8250=n

CONFIG_SERIAL_8250_CONSOLE=n

CONFIG_SERIAL_8250_DMA=n

CONFIG_SERIAL_8250_PCI=n

CONFIG_SERIAL_8250_NR_UARTS=n

CONFIG_SERIAL_8250_RUNTIME_UARTS=n

CONFIG_SERIAL_8250_FSL=n

CONFIG_SERIAL_OF_PLATFORM=n

CONFIG_SERIAL_AMBA_PL011=n

CONFIG_SERIAL_AMBA_PL011_CONSOLE=n

CONFIG_SERIAL_SAMSUNG=n

CONFIG_SERIAL_SAMSUNG_UARTS_4=n

CONFIG_SERIAL_SAMSUNG_UARTS=n

CONFIG_SERIAL_SAMSUNG_CONSOLE=n

CONFIG_SERIAL_CORE_CONSOLE=n

#CONFIG_SERIAL_MSM_GENI=n

#CONFIG_SERIAL_MSM_GENI_HALF_SAMPLING=n

CONFIG_SERIAL_SPRD=n

CONFIG_SERIAL_SPRD_CONSOLE=n

CONFIG_SERIAL_MCTRL_GPIO=n

#CONFIG_SCHED_DEBUG=n

CONFIG_DEBUG_BUGVERBOSE=n

CONFIG_DEBUG_LIST=n



CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_QGKI=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y


CONFIG_SLUB_DEBUG_PANIC_ON=n
CONFIG_IO_PGTABLE_PAGE_ACCOUNTING=n
CONFIG_SLUB_DEBUG_ON=n
CONFIG_DEBUG_KMEMLEAK=n
CONFIG_DEBUG_KMEMLEAK_EARLY_LOG_SIZE=4000
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=n
CONFIG_PAGE_POISONING=n
CONFIG_PAGE_POISONING_ENABLE_DEFAULT=n
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_KPROBES=n
CONFIG_QTI_SYS_PM_VX=n
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_CGF_NOTIFY_EVENT=y
CONFIG_USB_HUB_USB3803=y
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HH_DISABLE_UART=y
CONFIG_DEBUG_INFO=y
CONFIG_USB_EC_DRIVER=y
CONFIG_QTI_TZ_LOG=y
CONFIG_QCOM_EUD=n


CONFIG_MEMORY_HOTPLUG=n
CONFIG_MEMORY_HOTPLUG_SPARSE=n
CONFIG_MEMORY_HOTPLUG_MOVABLE_NODE=n


CONFIG_ARCH_QCOM=y
CONFIG_ASUS_POWER_DEBUG=y

CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_TIMERS=y

# ASUS_BSP : Booting +++
CONFIG_ASUS_GLOBAL_VAR=y
# ASUS_BSP : Booting ---

# SKILL.md Bring-up Requirements
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_MAILBOX=y
CONFIG_QCOM_SMEM=y
# CONFIG_BUILD_ARM64_DT_OVERLAY is not set

CONFIG_QCOM_WDT_CORE=y

# Build-fix: aura_sync/ms51_*.c unconditionally included but calls I2C functions
CONFIG_I2C=y

# Build-fix: datarmnet-ext shs uses rps_map which requires CONFIG_RPS
CONFIG_RPS=y

# Disable KernelSU (requires KPROBES or manual hooks)
# CONFIG_KSU is not set

# Non-GKI Monolithic Kernel: Core QCOM drivers must be built-in (=y) matching stock_defconfig
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SCM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_IPA3=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_HDCP_QSEECOM=y
CONFIG_MSM_SERVICE_LOCATOR=y
CONFIG_MSM_SERVICE_NOTIFIER=y
CONFIG_HH_RM_DRV=y
CONFIG_HAVEN_DRIVERS=y
CONFIG_MMC_CQHCI_CRYPTO_QTI=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_LAHAINA=y
CONFIG_QCOM_MINIDUMP=y
CONFIG_QCOM_SECURE_BUFFER=y
CONFIG_HH_DBL=y
CONFIG_REGULATOR_PROXY_CONSUMER=y
CONFIG_HDCP_QSEECOM=y
CONFIG_POWER_RESET_MSM=y
CONFIG_HH_MSGQ=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_UCSI_QTI_GLINK=y
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_MSM_SUBSYSTEM_RESTART=y

# Parent GKI module demotions — restore to built-in (=y) matching stock_defconfig
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_KGSL_IOMMU=y
CONFIG_TYPEC_UCSI=y
CONFIG_USB_BAM=y
CONFIG_USB_DWC3_MSM=y
CONFIG_MMC_CQHCI=y
CONFIG_QCOM_QSEECOM=y
CONFIG_MSM_PIL_MSS_QDSP6V5=y

# Final built-in drivers — matching stock_defconfig to complete vmlinux link
CONFIG_QSEECOM=y
CONFIG_MMC_CQHCI_CRYPTO=y
CONFIG_QTI_PMIC_GLINK=y
CONFIG_ARM_SMMU=y
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=y
CONFIG_SENSORS_SSC=y
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_INPUT_QPNP_POWER_ON=y

# Final 5 exact parent configs — matching stock_defconfig to complete vmlinux link
CONFIG_QSEECOM=y
CONFIG_QCOM_GLINK_PKT=y
CONFIG_USB_DWC3=y
CONFIG_SCSI_UFS_CRYPTO_QTI=y
CONFIG_QTI_IOMMU_SUPPORT=y

# Final 4 parent configs — matching stock_defconfig to complete vmlinux link
CONFIG_QTI_CRYPTO_COMMON=y
# CONFIG_QTI_CRYPTO_TZ is not set
CONFIG_QCOM_GLINK=y
CONFIG_USB_REDRIVER_NB7VPQ904M=y

# Final 7 built-in drivers — matching stock_defconfig to complete vmlinux link
CONFIG_RPMSG_QCOM_GLINK_SPSS=y
CONFIG_QTI_HW_KEY_MANAGER=y
CONFIG_LEDS_QTI_FLASH=y
CONFIG_QTI_ALTMODE_GLINK=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_QTI_ADC_TM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_HH_IRQ_LEND=y
CONFIG_HH_MEM_NOTIFIER=y
CONFIG_LEDS_QTI_FLASH=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_PDC=y

# Final 4 MODPOST module configs — matching stock_defconfig
CONFIG_QRTR=y
CONFIG_ICNSS2=y
CONFIG_INPUT_QCOM_HV_HAPTICS=y
# CONFIG_QCOM_DDR_STATS is not set
# CONFIG_QTI_DDR_STATS_LOG is not set
CONFIG_QPNP_PBS=y
CONFIG_QCOM_SOCINFO=y
# CONFIG_DRM_MSM is not set
